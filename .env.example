# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — .env.example
# ==============================================================================
# Copie este archivo como .env y complete con las credenciales de su entorno:
# cp .env.example .env
# ==============================================================================

# --- BASE DE DATOS ---
DB_DRIVER=mysql
DB_HOST=localhost:3308
DB_PORT=3308
DB_NAME=ipiales
DB_USER=usuario_bd
DB_PASS=contrasena_segura
DB_CHARSET=utf8

# --- SERVIDOR SMTP (CORREO INSTITUCIONAL) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=usuario@dominio.gov.co
SMTP_PASSWORD="clave_aplicacion_o_contrasena"
SMTP_FROM_NAME="Nombre Remitente"
SMTP_REPLY_TO=
SMTP_DEBUG=0
